        {
          "severity": "High",
          "area": "Tooth profile/lead vs case hardening",
          "description": "Carburise+quench to 58-62 HRC over a 0.6-0.9mm case will introduce distortion; holding ISO 1328 class 7 profile/lead as-hobbed alone is high risk.",
          "impact": "Rework/scrap risk, potential noise/vibration in service if class 7 not met",
          "fix": "Add a post-heat-treat hard finishing operation (form grind, hard hob, or shave-before-HT with tight distortion allowance) and specify inspection sampling plan."
        },
        {
          "severity": "High",
          "area": "40H7 bore after carburise",
          "description": "H7 bore tolerance is tight relative to expected heat-treat growth/distortion on a case-hardened part.",
          "impact": "Bore out of tolerance causes assembly/fit failures downstream",
          "fix": "Rough bore leaving 0.2-0.3mm grind stock pre-HT, finish bore/hone to H7 post-HT."
        },
        {
          "severity": "Medium",
          "area": "Root fillet / tooth root stress",
          "description": "No root fillet radius specified on the governing drawing; hobbing cutter tip radius must be controlled to avoid stress risers at 58-62 HRC case depth.",
          "impact": "Fatigue crack initiation at root under load if fillet too sharp",
          "fix": "Call out standard generating rack tip radius (~0.38mn) explicitly on the drawing."
        },
        {
          "severity": "Medium",
          "area": "Threaded feature discrepancy",
          "description": "B-rep geometry flags a threaded feature not shown on the attached governing sheet.",
          "impact": "Possible missed feature/cost if a lock-screw or plug thread is required but unquoted",
          "fix": "Request full drawing pack (all sheets) to confirm whether a thread feature exists elsewhere on the part."
        },
        {
          "severity": "Low",
          "area": "Face width / lead crowning",
          "description": "30mm face width at m3 is moderate; without lead crowning, edge loading can occur under misalignment.",
          "impact": "Localised wear/noise at gear edges over life",
          "fix": "Add a light lead crown (5-10µm) to the tooth flank specification."
        }
