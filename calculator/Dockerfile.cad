# CostVision production image WITH the STEP/IGES CAD geometry engine.
#
# The default (Alpine) Dockerfile can't run cadquery/OCP — the OpenCASCADE Python
# wheels are manylinux/glibc, not musl. This image uses a glibc base so the STEP
# measurement path works in production, not just the STL fast path. It is larger
# (~1.5 GB) and slower to build, which is why it's a separate file; fly.toml points
# here, while the small Alpine Dockerfile stays for fast local runs.
#
# Verified: cadquery 2.8.0 + OCP measures real STEP files on this exact glibc
# runtime (volume, bbox, B-rep faces, per-material weights).
FROM node:22-bookworm-slim AS app

# node-gyp build tools (better-sqlite3, bcrypt) + Python + the X/GL shared libs that
# OpenCASCADE (OCP) links against at import time, even when run headless.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip \
      build-essential \
      libgl1 libglu1-mesa libx11-6 libxext6 libxrender1 libsm6 libice6 libfontconfig1 libxi6 \
    && rm -rf /var/lib/apt/lists/*

# cadquery/OCP in an isolated venv (PEP 668-safe on Debian 12). Prepend it to PATH so
# the `python3` the server spawns (server/utils/geometry-bridge.ts) is this one — the
# interpreter that has cadquery. node/npm stay resolvable via the inherited PATH.
RUN python3 -m venv /opt/cq && /opt/cq/bin/pip install --no-cache-dir cadquery==2.8.0
ENV PATH="/opt/cq/bin:${PATH}"

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

EXPOSE 3002
ENV NODE_ENV=production
# The server listens on 127.0.0.1 by default; a container must listen on all
# interfaces or the published port cannot reach it.
ENV HOST=0.0.0.0
# Cap concurrent OCP processes to the memory budget (each costs a few hundred MB).
# With the warm pool (CV_GEOMETRY_POOL=1, default) this is the number of
# long-lived workers, each importing OCP once (2.9-4.0 s measured) and keeping
# a small LRU of loaded shapes. CV_GEOMETRY_QUEUE bounds waiting jobs;
# CV_POOL_MAX_JOBS recycles a worker after that many jobs.
ENV CV_MAX_PYTHON_PROCS=2
ENV CV_GEOMETRY_POOL=1
ENV CV_GEOMETRY_QUEUE=20

CMD ["npx", "tsx", "server/index.ts"]

# ── JLR internal server (Phase 1 readiness, Nov 2026) ───────────────────────────────────────────────────────────────────
# Build with `--target jlr` (deploy/jlr/docker-compose.yml does). Same app, plus:
#   - runs as an unprivileged user (uid 10001), never root;
#   - every file the app writes lives in the data volume (/app/data): database, drawing and CAD working files;
#   - a health check Docker (and JLR monitoring) can read;
#   - caches in /tmp, so the container's own file system can be mounted read-only.
# AI stays off through the settings file (AIR_GAPPED=1) — see deploy/jlr/settings.env.example.
FROM app AS jlr
RUN useradd --system --uid 10001 --user-group --create-home --home-dir /home/costvision costvision \
    && mkdir -p /app/data/drawing-files /app/data/geometry-files /app/data/backups \
    && chown -R costvision:costvision /app/data
ENV CV_DATA_DIR=/app/data \
    CV_DRAWING_FILE_DIR=/app/data/drawing-files \
    CV_GEOMETRY_FILE_DIR=/app/data/geometry-files \
    HOME=/home/costvision \
    XDG_CACHE_HOME=/tmp/.cache
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3002/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
USER 10001:10001
# tsx directly (npx would want a writable npm cache in HOME).
CMD ["/app/node_modules/.bin/tsx", "server/index.ts"]

# ── The default build (Fly.io, CI, `docker compose up` in the repo root) — unchanged, so it stays the LAST stage. ────────
FROM app AS default
