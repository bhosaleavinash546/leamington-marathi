/** Catalogue analogues for the manual costing: each unread line priced as a NAMED, distributor-priced catalogue part of the
 *  same kind and grade, at the parts bought a year (qty a board × 10,000 boards). Prints the candidates found. */
import { catalogueEntry, cataloguePriceAt } from '../../server/utils/pcb-price-catalogue.js';
import { readFileSync } from 'node:fs';
const cat = JSON.parse(readFileSync('server/data/pcb-component-catalogue.json', 'utf8')).parts as Array<Record<string, any>>;
const q = (re: RegExp, n = 6) => cat.filter(p => re.test(`${p.mpn} ${p.family} ${p.desc}`) && p.confidence === 'distributor').slice(0, n)
  .map(p => `${p.mpn} | ${p.desc.slice(0, 60)} | aecq ${p.aecq} | 1k £${p.gbp.q1k} 10k £${p.gbp.q10k} 100k £${p.gbp.q100k} | ${(p.volumeModel?.basis ?? '').slice(0, 40)} | obs ${(p.observations ?? []).length}`);
const show = (label: string, re: RegExp, n = 6) => { console.log(`\n## ${label}`); for (const l of q(re, n)) console.log('  ' + l); };
