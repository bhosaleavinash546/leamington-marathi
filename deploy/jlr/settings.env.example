# CostVision settings for the JLR server. Copy to settings.env, fill in, and keep it readable by root only:
#   cp settings.env.example settings.env && chmod 600 settings.env
# Never commit settings.env.

# Login-signing secret — REQUIRED (the server refuses to start without it). Generate once:
#   openssl rand -hex 32
JWT_SECRET=

# Phase 1: AI switched off. Every AI route refuses, even if a user offers a key; every costing works without AI.
# Phase 2: remove this line, add the key or JLR's approved AI route (ANTHROPIC_BASE_URL), restart.
AIR_GAPPED=1

# Who administers the tool (rate-book upload, dashboard admin). Comma-separated; these addresses may always sign up.
ADMIN_EMAILS=

# Sign-up is closed except for these email domains (comma-separated), e.g. jaguarlandrover.com
CV_SIGNUP_DOMAINS=

# Sign-in codes are emailed: JLR's internal mail relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Behind JLR's HTTPS gateway / reverse proxy: trust one proxy hop, so the app sees the user's real address
# (rate limits, the same-machine checks).
CV_TRUST_PROXY=1

PORT=3002
