# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. docs/OPERATIONS.md documents EVERY variable the
# codebase reads, and tests/env-documented.test.mjs fails CI if one is added
# without a row there — so that table, not this file, is the reference.
#
# The four below are the ones that decide whether a production deployment is
# safe. scripts/preflight.mjs refuses to pass without them.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. The server EXITS on boot in production without this (server.mjs:235):
# the fallback secret is in source control, so a default means anyone can forge
# any token, including an admin one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# REQUIRED in production. Encrypts users' stored Anthropic keys at rest. Falls
# back to JWT_SECRET, which couples the two: rotating the JWT secret would then
# make every stored key undecryptable. Generate it separately.
CREDENTIALS_SECRET=

# REQUIRED unless every user brings their own key in Settings.
ANTHROPIC_API_KEY=

# REQUIRED in production. Without SMTP credentials, one-time passcodes are
# PRINTED TO THE SERVER LOG instead of emailed — a development affordance that
# is an account-takeover hole the moment the app is reachable.
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM_NAME=BrainSpark

# Deployment
NODE_ENV=production
PORT=3001
DATA_DIR=/data
# Comma-separated. Only needed if the SPA is served from a different origin than
# the API — a normal single-container deploy serves both from one origin and
# does not need this at all.
# ALLOWED_ORIGINS=https://brainspark.example.com
# Trust-proxy hop count. Behind exactly one reverse proxy, 1 is correct. Wrong
# values make rate limiting count the proxy instead of the client.
TRUST_PROXY=1
LOG_LEVEL=info

# Admin
ADMIN_EMAILS=
# ADMIN_EMAIL / ADMIN_PASSWORD seed a first admin on an EMPTY database only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional research keys — see docs/RESEARCH-KEYS.md. Absent is handled
# honestly: Horizon labels results as "no live search" rather than inventing
# sources.
BRAVE_API_KEY=
PATENTSVIEW_API_KEY=

# Cost control
CV_MONTHLY_TOKEN_QUOTA=3000000
# Concurrent OCCT subprocesses. Each holds a full tessellation in memory —
# raise only with the RAM to match.
CV_MAX_PYTHON_PROCS=2
CV_MAX_CAD_WORKERS=2
